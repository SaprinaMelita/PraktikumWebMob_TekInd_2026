src/
├── Komponen/
│   ├── Sidebar.jsx      ← Navigasi kiri (NavLink aktif otomatis)
│   ├── Topbar.jsx       ← Header + jam real-time (useEffect)
│   └── KartuStat.jsx    ← Kartu statistik reusable (Props)
├── Halaman/
│   ├── Dashboard.jsx    ← Statistik + log hari ini
│   ├── InputLaporan.jsx ← Form lengkap + kalkulasi real-time
│   ├── RiwayatData.jsx  ← Tabel + filter + sortir
│   ├── JadwalShift.jsx  ← Jadwal operator minggu ini
│   └── NotFound.jsx     ← Halaman 404
├── utils/
│   └── storage.js       ← CRUD LocalStorage (simpan, ambil, hapus)

