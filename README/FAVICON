import React from 'react';

function RiwayatData() {

    // Ambil data LocalStorage
    const data = JSON.parse(
        localStorage.getItem('laporanProduksi')
    ) || [];

    return (
        <div className="container mt-4">

            <h1 className="mb-4 text-center">
                Riwayat Data Produksi
            </h1>

            <table className="table table-bordered table-striped">

                <thead className="table-dark">
                    <tr>
                        <th>Tanggal</th>
                        <th>Shift</th>
                        <th>Mesin</th>
                        <th>Total</th>
                        <th>Reject</th>
                        <th>Netto</th>
                    </tr>
                </thead>

                <tbody>

                    {data.length > 0 ? (

                        data.map((item) => (

                            <tr key={item.id}>
                                <td>{item.tanggal}</td>
                                <td>{item.shift}</td>
                                <td>{item.mesin}</td>
                                <td>{item.totalProduksi}</td>
                                <td>{item.reject}</td>
                                <td>{item.netto}</td>
                            </tr>

                        ))

                    ) : (

                        <tr>
                            <td colSpan="6" className="text-center">
                                Belum ada data.
                            </td>
                        </tr>

                    )}

                </tbody>

            </table>

        </div>
    );
}

export default RiwayatData;
```

