import React from 'react';

function Dashboard() {

    // Ambil data LocalStorage
    const data = JSON.parse(localStorage.getItem('laporanProduksi')) || [];

    // Hitung total produksi
    const totalProduksi = data.reduce(
        (total, item) => total + item.totalProduksi,
        0
    );

    // Hitung total reject
    const totalReject = data.reduce(
        (total, item) => total + item.reject,
        0
    );

    // Hitung yield
    const yieldPersen = totalProduksi > 0
        ? (((totalProduksi - totalReject) / totalProduksi) * 100).toFixed(2)
        : 0;

    return (
        <div className="container mt-4">

            <h1 className="mb-4 text-center">
                Dashboard Produksi
            </h1>

            <div className="row g-4">

                <div className="col-md-4">
                    <div className="card dashboard-card text-center p-4">
                        <h5>Total Produksi</h5>
                        <h2>{totalProduksi}</h2>
                    </div>
                </div>

                <div className="col-md-4">
                    <div className="card dashboard-card text-center p-4">
                        <h5>Total Reject</h5>
                        <h2>{totalReject}</h2>
                    </div>
                </div>

                <div className="col-md-4">
                    <div className="card dashboard-card text-center p-4">
                        <h5>Yield</h5>
                        <h2>{yieldPersen}%</h2>
                    </div>
                </div>

            </div>

        </div>
    );
}

export default Dashboard;
```

