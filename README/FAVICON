import React, { useState } from 'react';
import { useNavigate } from 'react-router-dom';

function InputLaporan() {

    const navigate = useNavigate();

    // State Form
    const [tanggal, setTanggal] = useState('');
    const [shift, setShift] = useState('Pagi');
    const [mesin, setMesin] = useState('');
    const [totalProduksi, setTotalProduksi] = useState(0);
    const [reject, setReject] = useState(0);

    // Netto otomatis
    const netto = totalProduksi - reject;

    // Simpan Data
    const handleSubmit = (e) => {

        e.preventDefault();

        const dataBaru = {
            id: Date.now(),
            tanggal,
            shift,
            mesin,
            totalProduksi,
            reject,
            netto
        };

        // Ambil data lama
        const dataLama = JSON.parse(
            localStorage.getItem('laporanProduksi')
        ) || [];

        // Tambahkan data baru di paling atas
        const dataUpdate = [dataBaru, ...dataLama];

        // Simpan ke LocalStorage
        localStorage.setItem(
            'laporanProduksi',
            JSON.stringify(dataUpdate)
        );

        // Pindah halaman
        navigate('/riwayat');
    };

    return (
        <div className="container mt-4">

            <div className="card p-4 shadow-sm">

                <h2 className="mb-4 text-center">
                    Input Laporan Produksi
                </h2>

                <form onSubmit={handleSubmit}>

                    <div className="mb-3">
                        <label className="form-label">
                            Tanggal
                        </label>

                        <input
                            type="date"
                            className="form-control"
                            value={tanggal}
                            onChange={(e) => setTanggal(e.target.value)}
                            required
                        />
                    </div>

                    <div className="mb-3">
                        <label className="form-label">
                            Shift
                        </label>

                        <select
                            className="form-select"
                            value={shift}
                            onChange={(e) => setShift(e.target.value)}
                        >
                            <option>Pagi</option>
                            <option>Siang</option>
                            <option>Malam</option>
                        </select>
                    </div>

                    <div className="mb-3">
                        <label className="form-label">
                            Nama Mesin
                        </label>

                        <input
                            type="text"
                            className="form-control"
                            placeholder="Masukkan nama mesin"
                            value={mesin}
                            onChange={(e) => setMesin(e.target.value)}
                            required
                        />
                    </div>

                    <div className="mb-3">
                        <label className="form-label">
                            Jumlah Produksi
                        </label>

                        <input
                            type="number"
                            className="form-control"
                            value={totalProduksi}
                            onChange={(e) =>
                                setTotalProduksi(Number(e.target.value))
                            }
                            required
                        />
                    </div>

                    <div className="mb-3">
                        <label className="form-label">
                            Jumlah Reject
                        </label>

                        <input
                            type="number"
                            className="form-control"
                            value={reject}
                            onChange={(e) =>
                                setReject(Number(e.target.value))
                            }
                            required
                        />
                    </div>

                    <div className="alert alert-info">
                        Netto Produksi: <strong>{netto}</strong>
                    </div>

                    <button
                        type="submit"
                        className="btn btn-primary w-100"
                    >
                        Simpan Laporan
                    </button>

                </form>

            </div>

        </div>
    );
}

export default InputLaporan;
```

